<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PulsarBattery.Device\PulsarBattery.Device.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\PulsarBattery\Services\BatteryMonitor.cs" Link="App\BatteryMonitor.cs" />
    <Compile Include="..\PulsarBattery\Services\AppSettings.cs" Link="App\AppSettings.cs" />
    <Compile Include="..\PulsarBattery\Services\AppSettingsService.cs" Link="App\AppSettingsService.cs" />
    <Compile Include="..\PulsarBattery\Services\SettingsStore.cs" Link="App\SettingsStore.cs" />
    <Compile Include="..\PulsarBattery\Services\HistoryStore.cs" Link="App\HistoryStore.cs" />
    <Compile Include="..\PulsarBattery\Services\PulsarBatteryReader.cs" Link="App\PulsarBatteryReader.cs" />
    <Compile Include="..\PulsarBattery\Services\SelfInstallService.cs" Link="App\SelfInstallService.cs" />
    <Compile Include="..\PulsarBattery\Services\StartupRegistrationService.cs" Link="App\StartupRegistrationService.cs" />
    <Compile Include="..\PulsarBattery\Services\DeviceImageService.cs" Link="App\DeviceImageService.cs" />
    <Compile Include="..\PulsarBattery\Models\BatteryReading.cs" Link="App\BatteryReading.cs" />
    <Compile Include="..\PulsarBattery\Tools\LocalizationService.cs" Link="App\LocalizationService.cs" />
    <Compile Include="..\PulsarBattery\Tools\JsonContext.cs" Link="App\JsonContext.cs" />
    <Compile Include="..\PulsarBattery\Tools\Log.cs" Link="App\Log.cs" />
    <Compile Include="..\PulsarBattery\Tools\Loc.cs" Link="App\Loc.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\PulsarBattery\Assets\Devices\*.png" Link="Assets\Devices\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
