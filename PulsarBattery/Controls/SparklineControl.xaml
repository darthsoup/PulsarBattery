<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PulsarBattery.Controls.SparklineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PulsarBattery.Controls"
    AutomationProperties.AccessibilityView="Content">

    <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="ScaleLabels" Margin="0,3,0,3">
            <TextBlock Text="100%" FontSize="10"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="50%" FontSize="10"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="0%" FontSize="10"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       AutomationProperties.AccessibilityView="Raw" />
        </Grid>

        <Grid x:Name="PlotHost"
              Grid.Column="1"
              MinHeight="96"
              SizeChanged="PlotHost_SizeChanged">
            <Border x:Name="ReferenceLine" Height="1" Margin="3,0,3,0" VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Path x:Name="FillPath" Opacity="0.15">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <Path x:Name="TrendLine"
                  Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                  StrokeThickness="2"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
            <Path x:Name="ReadingMarkers" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            <controls:TranslatedTextBlock x:Name="EmptyText"
                                          Text="No readings in the last 24 hours"
                                          TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextAlignment="Center"
                                          TextWrapping="Wrap"
                                          Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StartLabel"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="EndLabel" Grid.Column="1"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.AccessibilityView="Raw" />
        </Grid>
    </Grid>
</UserControl>
