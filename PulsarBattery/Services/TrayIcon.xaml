<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PulsarBattery.Services.TrayIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:converters="using:PulsarBattery.Converters">

    <UserControl.Resources>
        <!-- Converters -->
        <converters:BatteryPercentageConverter x:Key="BatteryPercentageConverter"/>
        <converters:ChargingStatusConverter x:Key="ChargingStatusConverter"/>
    </UserControl.Resources>

    <!-- TaskbarIcon -->
    <tb:TaskbarIcon
        x:Name="TaskbarIcon"
        ToolTipText="{x:Bind ViewModel.TrayTooltipText, Mode=OneWay}"
        ContextMenuMode="SecondWindow"
        NoLeftClickDelay="True">

        <!-- One permanently-attached GeneratedIconSource renders both styles:
             battery percentage as text, or the app icon via BackgroundSource
             with empty text. The IconSource is deliberately never swapped —
             H.NotifyIcon's IconSource change handler races its async icon
             updates and leaks change subscriptions. TextMargin carries the
             centering rectangle computed by the view model. -->
        <tb:TaskbarIcon.IconSource>
            <tb:GeneratedIconSource
                Text="{x:Bind ViewModel.TrayIconText, Mode=OneWay}"
                Foreground="{x:Bind ViewModel.TrayIconForeground, Mode=OneWay}"
                FontSize="{x:Bind ViewModel.TrayIconFontSize, Mode=OneWay}"
                TextMargin="{x:Bind ViewModel.TrayIconTextMargin, Mode=OneWay}"
                BackgroundSource="{x:Bind ViewModel.TrayIconBackgroundSource, Mode=OneWay}"
                FontWeight="Bold" />
        </tb:TaskbarIcon.IconSource>

        <tb:TaskbarIcon.ContextFlyout>
            <!-- SecondWindow mode sizes its host window from each item's measured
                 DesiredSize; items whose x:Bind text changed can momentarily measure
                 too narrow, clipping the menu. MinWidth on the items is the only
                 sizing input that reaches that measurement (MenuFlyoutPresenterStyle
                 is not copied to the second window's flyout). -->
            <MenuFlyout AreOpenCloseAnimationsEnabled="True">
                <!-- Model -->
                <MenuFlyoutItem
                    MinWidth="200"
                    Text="{x:Bind ViewModel.ModelName, Mode=OneWay}"
                    IsEnabled="False">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE962;" FontFamily="Segoe Fluent Icons"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <!-- Battery Status -->
                <MenuFlyoutItem
                    MinWidth="200"
                    Text="{x:Bind ViewModel.BatteryPercentage, Converter={StaticResource BatteryPercentageConverter}, Mode=OneWay}"
                    IsEnabled="False">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xEBAA;" FontFamily="Segoe Fluent Icons"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                
                <!-- Charging Status -->
                <MenuFlyoutItem
                    MinWidth="200"
                    Text="{x:Bind ViewModel.IsCharging, Converter={StaticResource ChargingStatusConverter}, Mode=OneWay}"
                    IsEnabled="False">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xEBAB;" FontFamily="Segoe Fluent Icons"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                
                <MenuFlyoutSeparator/>
                
                <!-- Open Command -->
                <MenuFlyoutItem
                    MinWidth="200"
                    Text="Open"
                    x:Name="OpenMenuItem">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <!-- Exit Command -->
                <MenuFlyoutItem
                    MinWidth="200"
                    Text="Exit"
                    x:Name="ExitMenuItem">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe Fluent Icons"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </tb:TaskbarIcon.ContextFlyout>
    </tb:TaskbarIcon>

</UserControl>
