<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PulsarBattery.Services.TrayIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <tb:TaskbarIcon
        x:Name="TaskbarIcon"
        ToolTipText="{x:Bind ViewModel.TrayTooltipText, Mode=OneWay}"
        ContextMenuMode="SecondWindow"
        NoLeftClickDelay="True">

        <!-- IconSource races the library's async updates and overwrites our rendered icon on DPI changes.
             Assign Icon only through the renderer's UI-thread path. -->

        <tb:TaskbarIcon.ContextFlyout>
            <!-- SecondWindow measures individual items; their MinWidth prevents clipped changing text.
                 MenuFlyoutPresenterStyle is not copied to that host. -->
            <MenuFlyout AreOpenCloseAnimationsEnabled="True">
                <MenuFlyoutItem
                    x:Name="ModelMenuItem"
                    MinWidth="280"
                    IsEnabled="False">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE962;" FontFamily="Segoe Fluent Icons"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <MenuFlyoutItem
                    x:Name="BatteryMenuItem"
                    MinWidth="280"
                    IsEnabled="False">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xEBAA;" FontFamily="Segoe Fluent Icons"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                
                <MenuFlyoutItem
                    x:Name="StatusMenuItem"
                    MinWidth="280"
                    IsEnabled="False">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xEBAB;" FontFamily="Segoe Fluent Icons"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <MenuFlyoutItem
                    x:Name="LastUpdatedMenuItem"
                    MinWidth="280"
                    IsEnabled="False">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE823;" FontFamily="Segoe Fluent Icons"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                
                <MenuFlyoutSeparator/>
                
                <MenuFlyoutItem
                    MinWidth="280"
                    Text="Open"
                    x:Name="OpenMenuItem"
                    AccessKey="O">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <MenuFlyoutItem
                    x:Name="RefreshMenuItem"
                    MinWidth="280"
                    Text="Refresh battery status"
                    AccessKey="R">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <MenuFlyoutItem
                    MinWidth="280"
                    Text="Exit"
                    x:Name="ExitMenuItem"
                    AccessKey="X">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe Fluent Icons"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </tb:TaskbarIcon.ContextFlyout>
    </tb:TaskbarIcon>

</UserControl>
