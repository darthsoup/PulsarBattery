<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PulsarBattery.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PulsarBattery.Controls"
    xmlns:settingscontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:PulsarBattery.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:DoubleToIntConverter x:Key="DoubleToIntConverter" />

        <Style x:Key="SettingsSectionHeaderStyle" TargetType="controls:TranslatedTextBlock">
            <Setter Property="TextStyle" Value="{ThemeResource BodyStrongTextBlockStyle}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Unbased on purpose: WindowsAppSDK ships no DefaultNumberBoxStyle key
             (NumberBox has only an unkeyed implicit style), so there is nothing to
             base on. Minimum/Maximum stay local because they differ per box. -->
        <Style x:Key="SettingsNumberBoxStyle" TargetType="NumberBox">
            <Setter Property="Width" Value="120" />
            <Setter Property="SpinButtonPlacementMode" Value="Compact" />
            <Setter Property="SmallChange" Value="1" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="RootGrid"
              Padding="32,24,32,32"
              Background="Transparent"
              PointerPressed="RootGrid_PointerPressed">
            <StackPanel Spacing="24" MaxWidth="1000">

                <!-- Negative bottom margin cancels the ~8px of slack that TitleTextBlockStyle's
                     36px LineHeight leaves below the glyphs. Without it the panel's 24px Spacing
                     reads as ~33px under the title but ~25px between sections, so the title
                     looks detached from the page it heads. -->
                <controls:TranslatedTextBlock Text="Settings"
                                              TextStyle="{ThemeResource TitleTextBlockStyle}"
                                              Margin="0,0,0,-8" />

                <StackPanel Spacing="4">
                    <controls:TranslatedTextBlock Text="Monitoring"
                                                  Style="{StaticResource SettingsSectionHeaderStyle}" />

                    <settingscontrols:SettingsCard x:Name="PollIntervalCard">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <NumberBox x:Name="PollIntervalNumberBox"
                                       Minimum="1"
                                       Maximum="120"
                                       Value="{x:Bind ViewModel.PollIntervalMinutes, Mode=TwoWay}"
                                       Style="{StaticResource SettingsNumberBoxStyle}" />
                            <controls:TranslatedTextBlock Text="min"
                                                          TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          VerticalAlignment="Center" />
                        </StackPanel>
                    </settingscontrols:SettingsCard>

                    <settingscontrols:SettingsCard x:Name="LogIntervalCard">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <NumberBox x:Name="LogIntervalNumberBox"
                                       Minimum="1"
                                       Maximum="240"
                                       Value="{x:Bind ViewModel.LogIntervalMinutes, Mode=TwoWay}"
                                       Style="{StaticResource SettingsNumberBoxStyle}" />
                            <controls:TranslatedTextBlock Text="min"
                                                          TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          VerticalAlignment="Center" />
                        </StackPanel>
                    </settingscontrols:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="4">
                    <controls:TranslatedTextBlock Text="Notifications"
                                                  Style="{StaticResource SettingsSectionHeaderStyle}" />

                    <settingscontrols:SettingsExpander x:Name="LowBatteryExpander">
                        <settingscontrols:SettingsExpander.Items>
                            <settingscontrols:SettingsCard x:Name="AlertThresholdUnlockedCard">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <NumberBox x:Name="AlertThresholdUnlockedNumberBox"
                                               Minimum="1"
                                               Maximum="100"
                                               Value="{x:Bind ViewModel.AlertThresholdUnlockedPercent, Mode=TwoWay, Converter={StaticResource DoubleToIntConverter}}"
                                               Style="{StaticResource SettingsNumberBoxStyle}" />
                                    <TextBlock Text="%"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </settingscontrols:SettingsCard>

                            <settingscontrols:SettingsCard x:Name="AlertThresholdLockedCard">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <NumberBox x:Name="AlertThresholdLockedNumberBox"
                                               Minimum="1"
                                               Maximum="100"
                                               Value="{x:Bind ViewModel.AlertThresholdLockedPercent, Mode=TwoWay, Converter={StaticResource DoubleToIntConverter}}"
                                               Style="{StaticResource SettingsNumberBoxStyle}" />
                                    <TextBlock Text="%"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </settingscontrols:SettingsCard>

                            <settingscontrols:SettingsCard x:Name="AlertCooldownCard">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <NumberBox x:Name="AlertCooldownNumberBox"
                                               Minimum="0"
                                               Maximum="1440"
                                               Value="{x:Bind ViewModel.AlertCooldownMinutes, Mode=TwoWay}"
                                               Style="{StaticResource SettingsNumberBoxStyle}" />
                                    <controls:TranslatedTextBlock Text="min"
                                                                  TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                  VerticalAlignment="Center" />
                                </StackPanel>
                            </settingscontrols:SettingsCard>

                            <settingscontrols:SettingsCard x:Name="EnableBeepsCard">
                                <ToggleSwitch IsOn="{x:Bind ViewModel.EnableBeeps, Mode=TwoWay}"
                                              x:Name="EnableBeepsToggle" />
                            </settingscontrols:SettingsCard>

                            <settingscontrols:SettingsCard x:Name="AlertSoundCard">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Read-only TextBox rather than a trimmed TextBlock so the
                                         path stays scrollable, selectable and copyable. -->
                                    <TextBox x:Name="AlertSoundPathTextBox"
                                             Text="{x:Bind ViewModel.LowBatterySoundDisplay, Mode=OneWay}"
                                             ToolTipService.ToolTip="{x:Bind ViewModel.LowBatterySoundDisplay, Mode=OneWay}"
                                             IsReadOnly="True"
                                             TextWrapping="NoWrap"
                                             MinWidth="200"
                                             MaxWidth="360" />
                                    <Button x:Name="ChooseSoundButton" Click="ChooseLowBatterySound_Click" />
                                    <Button x:Name="ClearSoundButton" Click="ClearLowBatterySound_Click" />
                                </StackPanel>
                            </settingscontrols:SettingsCard>
                        </settingscontrols:SettingsExpander.Items>
                    </settingscontrols:SettingsExpander>

                    <settingscontrols:SettingsCard x:Name="QuickActionsCard" ContentAlignment="Left">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SendLowBatteryTestButton"
                                        Click="SendLowBatteryTest_Click"
                                        Style="{ThemeResource AccentButtonStyle}" />
                                <Button x:Name="RefreshBatteryStatusButton"
                                        Click="RefreshBatteryStatus_Click" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.LastUpdatedText, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </settingscontrols:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="4">
                    <controls:TranslatedTextBlock Text="Window behavior"
                                                  Style="{StaticResource SettingsSectionHeaderStyle}" />

                    <settingscontrols:SettingsCard x:Name="MinimizeToTrayCard">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.MinimizeToTrayOnClose, Mode=TwoWay}"
                                      x:Name="MinimizeToTrayToggle" />
                    </settingscontrols:SettingsCard>

                    <settingscontrols:SettingsCard x:Name="ShowBatteryInTrayCard">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ShowBatteryInTray, Mode=TwoWay}"
                                      x:Name="ShowBatteryInTrayToggle" />
                    </settingscontrols:SettingsCard>

                    <settingscontrols:SettingsCard x:Name="StartWithWindowsCard">
                        <!-- IsOn is driven from code via ApplyStartWithWindowsToggleState, not a
                             OneWay x:Bind: the binding's initial push raises Toggled while no guard
                             is armed, which re-enters the autostart install flow. -->
                        <ToggleSwitch x:Name="StartWithWindowsToggle"
                                      Toggled="StartWithWindowsToggle_Toggled" />
                    </settingscontrols:SettingsCard>

                    <InfoBar x:Name="InstallInfoBar"
                             IsOpen="False"
                             IsClosable="True"
                             Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <controls:TranslatedTextBlock Text="Language"
                                                  Style="{StaticResource SettingsSectionHeaderStyle}" />

                    <settingscontrols:SettingsCard x:Name="LanguageCard">
                        <!-- Tag carries the persisted AppSettings.Language value. "auto" is a
                             UI-only sentinel that maps to null on disk; a null Tag made "user
                             picked Auto" indistinguishable from "SelectionChanged fired with no
                             selection", which silently wiped the saved language.
                             Language names are endonyms and intentionally not localized. -->
                        <ComboBox x:Name="LanguageComboBox"
                                  MinWidth="200"
                                  SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem x:Name="LanguageAutoItem" Tag="auto" />
                            <ComboBoxItem Content="English" Tag="en-US" />
                            <ComboBoxItem Content="Deutsch" Tag="de-DE" />
                        </ComboBox>
                    </settingscontrols:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="4">
                    <controls:TranslatedTextBlock Text="About"
                                                  Style="{StaticResource SettingsSectionHeaderStyle}" />

                    <!-- Product name and copyright are intentionally not localized (a German
                         rendering would be byte-identical), so this expander needs no x:Name
                         or ApplyLocalization entry. The toolkit's automation peer already
                         exposes Header as the accessible name. -->
                    <settingscontrols:SettingsExpander
                        Header="Pulsar Battery"
                        Description="&#169; 2026 darthsoup, Elehiggle">
                        <settingscontrols:SettingsExpander.HeaderIcon>
                            <ImageIcon Source="/Assets/StoreLogo.png" />
                        </settingscontrols:SettingsExpander.HeaderIcon>

                        <TextBlock Text="{x:Bind AppVersion}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />

                        <settingscontrols:SettingsExpander.Items>
                            <settingscontrols:SettingsCard x:Name="ViewOnGitHubCard"
                                Description="github.com/darthsoup/PulsarBattery"
                                IsClickEnabled="True"
                                Click="GitHubCard_Click">
                                <settingscontrols:SettingsCard.ActionIcon>
                                    <FontIcon Glyph="&#xE8A7;" />
                                </settingscontrols:SettingsCard.ActionIcon>
                            </settingscontrols:SettingsCard>
                        </settingscontrols:SettingsExpander.Items>
                    </settingscontrols:SettingsExpander>
                </StackPanel>

            </StackPanel>
            <!-- Invisible focus target: clicking empty page space moves focus here so a
                 NumberBox being edited loses focus and commits its value (NumberBox only
                 updates its binding on focus loss). See RootGrid_PointerPressed. -->
            <Button x:Name="FocusSink"
                    Width="1"
                    Height="1"
                    Opacity="0"
                    IsHitTestVisible="False"
                    TabIndex="-1" />
        </Grid>
    </ScrollViewer>
</Page>
