<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PulsarBattery.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PulsarBattery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <!-- StateTriggers are only evaluated when the VisualStateGroups sit on the
             Page's first child — keep them on this ScrollViewer, not a descendant. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="680" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentRoot.Padding" Value="16,16,16,24" />
                        <Setter Target="DeviceImageHost.Visibility" Value="Collapsed" />
                        <Setter Target="PercentageText.FontSize" Value="40" />
                        <Setter Target="PercentageHost.Margin" Value="12,0,0,0" />
                        <!-- Stat tiles reflow 4-across → 2×2 (each tile spans two of the four star columns) -->
                        <Setter Target="ConnectionTile.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="FirmwareTile.(Grid.Column)" Value="2" />
                        <Setter Target="FirmwareTile.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="PollingTile.(Grid.Column)" Value="0" />
                        <Setter Target="PollingTile.(Grid.Row)" Value="1" />
                        <Setter Target="PollingTile.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="PollingTile.Margin" Value="0,8,0,0" />
                        <Setter Target="DpiTile.(Grid.Column)" Value="2" />
                        <Setter Target="DpiTile.(Grid.Row)" Value="1" />
                        <Setter Target="DpiTile.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DpiTile.Margin" Value="8,8,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid x:Name="ContentRoot" Padding="32,24,32,32">
            <StackPanel Spacing="24" MaxWidth="1000">

                <controls:TranslatedTextBlock Text="Dashboard" TextStyle="{ThemeResource TitleTextBlockStyle}" />

                <!-- Loading indicator (shown when no data is available yet) -->
                <Border Style="{StaticResource PulsarCardStyle}"
                        Padding="40"
                        MinHeight="200"
                        Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                Spacing="16">
                        <ProgressRing IsActive="True" 
                                      Width="48" 
                                      Height="48" />
                        <controls:TranslatedTextBlock Text="Loading battery information..."
                                                      TextStyle="{ThemeResource BodyStrongTextBlockStyle}"
                                                      HorizontalAlignment="Center" />
                        <controls:TranslatedTextBlock Text="Please wait while we connect to your device"
                                                      TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- No Device Found indicator -->
                <Border Style="{StaticResource PulsarCardStyle}"
                        Padding="40"
                        MinHeight="300"
                        Visibility="{x:Bind ViewModel.NoDeviceVisibility, Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                Spacing="20">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="32"
                                Width="64"
                                Height="64"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE7EF;" 
                                      FontSize="32"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <controls:TranslatedTextBlock Text="No Pulsar mouse detected"
                                                      TextStyle="{ThemeResource TitleTextBlockStyle}"
                                                      HorizontalAlignment="Center" />
                        <StackPanel Spacing="8" MaxWidth="450">
                            <controls:TranslatedTextBlock Text="Make sure your Pulsar mouse is connected and powered on."
                                                          TextStyle="{ThemeResource BodyTextBlockStyle}"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          TextAlignment="Center"
                                                          TextWrapping="Wrap"
                                                          HorizontalAlignment="Center" />
                            <HyperlinkButton NavigateUri="https://github.com/darthsoup/PulsarBattery#supported-devices"
                                             HorizontalAlignment="Center"
                                             Margin="0,8,0,0"
                                             Padding="4,2">
                                <controls:TranslatedTextBlock Text="See supported devices on GitHub"
                                                              TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                              TextAlignment="Center"
                                                              TextWrapping="Wrap" />
                            </HyperlinkButton>
                        </StackPanel>
                        <Button x:Name="RetryButton"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0"
                                Click="RetryConnection_Click" />
                    </StackPanel>
                </Border>

                <!-- Main content (shown when data is available) -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">

                    <!-- Battery Status Card -->
                    <Grid>
                        <!-- Loading indicator when refreshing with cached data -->
                        <StackPanel Orientation="Horizontal" 
                                    Spacing="8" 
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,8,16,0"
                                    Visibility="{x:Bind ViewModel.RefreshingVisibility, Mode=OneWay}">
                            <ProgressRing IsActive="True" 
                                          Width="16" 
                                          Height="16" />
                            <controls:TranslatedTextBlock Text="Updating..."
                                                          TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Main battery card -->
                        <Border Style="{StaticResource PulsarCardStyle}"
                                Padding="16"
                                MinHeight="120">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Device picture (host grid so the narrow visual state can
                                     collapse it without fighting the view-model binding) -->
                                <Grid x:Name="DeviceImageHost" Grid.Row="0" Grid.Column="0">
                                    <Image Height="110"
                                           Margin="0,0,20,0"
                                           VerticalAlignment="Center"
                                           Source="{x:Bind ViewModel.DeviceImage, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.DeviceImageVisibility, Mode=OneWay}" />
                                </Grid>

                                <!-- Left side - Battery info -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.ModelName, Mode=OneWay}" 
                                               Style="{ThemeResource TitleTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.BatteryDetailText, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.LastUpdatedText, Mode=OneWay}" 
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <!-- Right side - Large percentage (state-colored from code-behind) -->
                                <StackPanel x:Name="PercentageHost"
                                            Grid.Row="0" Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Margin="24,0,0,0">
                                    <FontIcon Glyph="&#xE945;"
                                              FontSize="20"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.AccessibilityView="Raw"
                                              Visibility="{x:Bind ViewModel.ChargingGlyphVisibility, Mode=OneWay}" />
                                    <TextBlock x:Name="PercentageText"
                                               VerticalAlignment="Center"
                                               FontSize="56"
                                               FontWeight="SemiBold">
                                        <Run Text="{x:Bind ViewModel.BatteryPercentage, Mode=OneWay}" /><Run Text="%" FontSize="40" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- Progress bar (full width) -->
                                <ProgressBar x:Name="BatteryBar"
                                             Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{x:Bind ViewModel.BatteryPercentage, Mode=OneWay}"
                                             Height="6"
                                             Margin="0,16,0,0" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Battery trend -->
                    <Border Style="{StaticResource PulsarCardStyle}" Padding="16">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:TranslatedTextBlock Text="Battery trend"
                                                                  TextStyle="{ThemeResource BodyStrongTextBlockStyle}"
                                                                  VerticalAlignment="Center" />
                                    <controls:TranslatedTextBlock Text="Last 24 hours"
                                                                  TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                  VerticalAlignment="Center" />
                                </StackPanel>
                                <HyperlinkButton HorizontalAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 Padding="4,2"
                                                 Click="ViewHistory_Click">
                                    <controls:TranslatedTextBlock Text="View history"
                                                                  TextStyle="{ThemeResource CaptionTextBlockStyle}" />
                                </HyperlinkButton>
                            </Grid>

                            <controls:SparklineControl Grid.Row="1"
                                                       Height="120"
                                                       Readings="{x:Bind ViewModel.History}" />
                        </Grid>
                    </Border>

                    <!-- At-a-glance stats -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="ConnectionTile" Grid.Column="0" Style="{StaticResource PulsarCardStyle}" Padding="16"
                                ToolTipService.ToolTip="{x:Bind ViewModel.ConnectionToolTip, Mode=OneWay}">
                            <StackPanel Spacing="4">
                                <controls:TranslatedTextBlock Text="Connection"
                                                              TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.ConnectionDetailText, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.ConnectionDetailVisibility, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="FirmwareTile" Grid.Column="1" Style="{StaticResource PulsarCardStyle}" Padding="16" Margin="8,0,0,0">
                            <StackPanel Spacing="4">
                                <controls:TranslatedTextBlock Text="Firmware"
                                                              TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FirmwareText, Mode=OneWay}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="PollingTile" Grid.Column="2" Style="{StaticResource PulsarCardStyle}" Padding="16" Margin="8,0,0,0">
                            <StackPanel Spacing="4">
                                <controls:TranslatedTextBlock Text="Polling rate"
                                                              TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.PollingRateText, Mode=OneWay}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="DpiTile" Grid.Column="3" Style="{StaticResource PulsarCardStyle}" Padding="16" Margin="8,0,0,0">
                            <StackPanel Spacing="4">
                                <controls:TranslatedTextBlock Text="DPI"
                                                              TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.DpiText, Mode=OneWay}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
