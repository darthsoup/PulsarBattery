<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PulsarBattery.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PulsarBattery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <!-- StateTriggers are only evaluated when the VisualStateGroups sit on the
             Page's first child, so keep them on this ScrollViewer, not a descendant. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="680" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentRoot.Padding" Value="16,16,16,24" />
                        <Setter Target="DeviceImageHost.Visibility" Value="Collapsed" />
                        <Setter Target="LoadingCard.Padding" Value="24" />
                        <Setter Target="NoDeviceCard.Padding" Value="24" />
                        <Setter Target="RefreshButtonLabels.Visibility" Value="Collapsed" />
                        <Setter Target="DeviceSummary.(Grid.Column)" Value="0" />
                        <Setter Target="DeviceSummary.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="PercentageText.FontSize" Value="44" />
                        <Setter Target="PercentageHost.(Grid.Row)" Value="1" />
                        <Setter Target="PercentageHost.(Grid.Column)" Value="0" />
                        <Setter Target="PercentageHost.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="PercentageHost.HorizontalAlignment" Value="Left" />
                        <Setter Target="PercentageHost.Margin" Value="0,16,0,0" />
                        <Setter Target="BatteryLevelLabel.HorizontalAlignment" Value="Left" />
                        <Setter Target="BatteryLevelLabel.TextAlignment" Value="Left" />
                        <Setter Target="BatteryBar.(Grid.Row)" Value="2" />
                        <Setter Target="LastUpdatedText.(Grid.Row)" Value="3" />
                        <Setter Target="ViewHistoryButton.(Grid.Row)" Value="1" />
                        <Setter Target="ViewHistoryButton.(Grid.Column)" Value="0" />
                        <Setter Target="ViewHistoryButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="ViewHistoryButton.Margin" Value="-4,4,0,0" />
                        <Setter Target="ConnectionTile.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="FirmwareTile.(Grid.Column)" Value="2" />
                        <Setter Target="FirmwareTile.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="PollingTile.(Grid.Column)" Value="0" />
                        <Setter Target="PollingTile.(Grid.Row)" Value="1" />
                        <Setter Target="PollingTile.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="PollingTile.Margin" Value="0,8,0,0" />
                        <Setter Target="DpiTile.(Grid.Column)" Value="2" />
                        <Setter Target="DpiTile.(Grid.Row)" Value="1" />
                        <Setter Target="DpiTile.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DpiTile.Margin" Value="8,8,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid x:Name="ContentRoot" Padding="32,24,32,32">
            <StackPanel Spacing="24" MaxWidth="1000">

                <!-- The negative margin removes the title style's extra line-height slack. -->
                <Grid Margin="0,0,0,-8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:TranslatedTextBlock Text="Dashboard"
                                                  TextStyle="{ThemeResource TitleTextBlockStyle}"
                                                  VerticalAlignment="Center" />
                    <Button x:Name="RefreshButton"
                            Grid.Column="1"
                            MinWidth="36"
                            MinHeight="36"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                            Click="RetryConnection_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid Width="20" Height="20">
                                <FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" FontSize="16"
                                          AutomationProperties.AccessibilityView="Raw" />
                                <ProgressRing x:Name="RefreshProgress"
                                              Width="20" Height="20" IsActive="False"
                                              AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                            <!-- Transparent labels reserve the widest localized state without changing button size. -->
                            <Grid x:Name="RefreshButtonLabels" VerticalAlignment="Center">
                                <TextBlock x:Name="RefreshIdleMeasure" Opacity="0"
                                           AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="RefreshBusyMeasure" Opacity="0"
                                           AutomationProperties.AccessibilityView="Raw" />
                                <controls:TranslatedTextBlock x:Name="RefreshButtonLabel" Text="Refresh"
                                                              AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border x:Name="LoadingCard" Style="{StaticResource PulsarCardStyle}"
                        Padding="40"
                        MinHeight="200"
                        Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="16">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                      Width="48"
                                      Height="48" />
                        <controls:TranslatedTextBlock Text="Loading battery information..."
                                                      TextStyle="{ThemeResource BodyStrongTextBlockStyle}"
                                                      TextAlignment="Center"
                                                      TextWrapping="Wrap"
                                                      HorizontalAlignment="Center" />
                        <controls:TranslatedTextBlock Text="Please wait while we connect to your device"
                                                      TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      TextAlignment="Center"
                                                      TextWrapping="Wrap"
                                                      HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border x:Name="NoDeviceCard" Style="{StaticResource PulsarCardStyle}"
                        Padding="40"
                        MinHeight="300"
                        Visibility="{x:Bind ViewModel.NoDeviceVisibility, Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="20">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="32"
                                Width="64"
                                Height="64"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE7EF;"
                                      AutomationProperties.AccessibilityView="Raw"
                                      FontSize="32"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <controls:TranslatedTextBlock Text="No Pulsar mouse detected"
                                                      TextStyle="{ThemeResource SubtitleTextBlockStyle}"
                                                      TextAlignment="Center"
                                                      TextWrapping="Wrap"
                                                      HorizontalAlignment="Center" />
                        <StackPanel Spacing="8" MaxWidth="450">
                            <controls:TranslatedTextBlock Text="Make sure your Pulsar mouse is connected and powered on."
                                                          TextStyle="{ThemeResource BodyTextBlockStyle}"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          TextAlignment="Center"
                                                          TextWrapping="Wrap"
                                                          HorizontalAlignment="Center" />
                            <HyperlinkButton NavigateUri="https://github.com/darthsoup/PulsarBattery#supported-devices"
                                             HorizontalAlignment="Center"
                                             Margin="0,8,0,0"
                                             Padding="4,2">
                                <controls:TranslatedTextBlock Text="See supported devices on GitHub"
                                                              TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                              TextAlignment="Center"
                                                              TextWrapping="Wrap" />
                            </HyperlinkButton>
                        </StackPanel>
                        <Button x:Name="RetryButton"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0"
                                IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                                Click="RetryConnection_Click" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">

                    <InfoBar x:Name="StaleDataInfoBar"
                             IsOpen="{x:Bind ViewModel.HasStaleData, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.StaleDataVisibility, Mode=OneWay}"
                             Message="{x:Bind ViewModel.StaleDataText, Mode=OneWay}"
                             Severity="Warning"
                             IsClosable="False" />

                    <Border Style="{StaticResource PulsarCardStyle}" Padding="20" MinHeight="152">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- The host separates the responsive layout state from image availability. -->
                            <Grid x:Name="DeviceImageHost" Grid.Row="0" Grid.Column="0">
                                <Image Height="110"
                                       MaxWidth="140"
                                       Margin="0,0,20,0"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw"
                                       Source="{x:Bind ViewModel.DeviceImage, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.DeviceImageVisibility, Mode=OneWay}" />
                            </Grid>

                            <StackPanel x:Name="DeviceSummary" Grid.Row="0" Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.DeviceStatusText, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.ModelName, Mode=OneWay}"
                                           Style="{ThemeResource TitleTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                                <TextBlock Text="{x:Bind ViewModel.BatteryDetailText, Mode=OneWay}"
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel x:Name="PercentageHost"
                                        Grid.Row="0" Grid.Column="2"
                                        Spacing="2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Margin="24,0,0,0">
                                <controls:TranslatedTextBlock x:Name="BatteryLevelLabel"
                                                              Text="Battery level"
                                                              MaxWidth="180"
                                                              TextWrapping="Wrap"
                                                              TextAlignment="Right"
                                                              TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              HorizontalAlignment="Right" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE945;"
                                              FontSize="20"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.AccessibilityView="Raw"
                                              Visibility="{x:Bind ViewModel.ChargingGlyphVisibility, Mode=OneWay}" />
                                    <TextBlock x:Name="PercentageText"
                                               VerticalAlignment="Center"
                                               FontSize="56"
                                               FontWeight="SemiBold">
                                        <Run Text="{x:Bind ViewModel.BatteryPercentage, Mode=OneWay}" /><Run Text="%" FontSize="32" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <ProgressBar x:Name="BatteryBar"
                                         Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{x:Bind ViewModel.BatteryPercentage, Mode=OneWay}"
                                         Height="6"
                                         Margin="0,16,0,0" />
                            <TextBlock x:Name="LastUpdatedText"
                                       Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0">
                                <Run x:Name="LastUpdatedLabel" /><Run Text="{x:Bind ViewModel.LastUpdatedText, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PulsarCardStyle}" Padding="16">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="2">
                                    <controls:TranslatedTextBlock Text="Battery trend"
                                                                  TextStyle="{ThemeResource BodyStrongTextBlockStyle}"
                                                                  VerticalAlignment="Center" />
                                    <controls:TranslatedTextBlock Text="Last 24 hours"
                                                                  TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                  VerticalAlignment="Center" />
                                </StackPanel>
                                <HyperlinkButton x:Name="ViewHistoryButton"
                                                 Grid.Column="1"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 Padding="4,2"
                                                 Click="ViewHistory_Click">
                                    <controls:TranslatedTextBlock Text="View history"
                                                                  TextStyle="{ThemeResource CaptionTextBlockStyle}" />
                                </HyperlinkButton>
                            </Grid>

                            <controls:SparklineControl Grid.Row="1"
                                                       MinHeight="120"
                                                       Readings="{x:Bind ViewModel.History}"
                                                       ModelName="{x:Bind ViewModel.ModelName, Mode=OneWay}"
                                                       LogIntervalMinutes="{x:Bind ViewModel.LogIntervalMinutes, Mode=OneWay}"
                                                       PollIntervalMinutes="{x:Bind ViewModel.PollIntervalMinutes, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="ConnectionTile" Grid.Column="0" Style="{StaticResource PulsarCardStyle}" Padding="16"
                                ToolTipService.ToolTip="{x:Bind ViewModel.ConnectionToolTip, Mode=OneWay}">
                            <StackPanel Spacing="4">
                                <controls:TranslatedTextBlock Text="Connection"
                                                              TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.ConnectionDetailText, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.ConnectionDetailVisibility, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="FirmwareTile" Grid.Column="1" Style="{StaticResource PulsarCardStyle}" Padding="16" Margin="8,0,0,0">
                            <StackPanel Spacing="4">
                                <controls:TranslatedTextBlock Text="Firmware"
                                                              TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FirmwareText, Mode=OneWay}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="PollingTile" Grid.Column="2" Style="{StaticResource PulsarCardStyle}" Padding="16" Margin="8,0,0,0">
                            <StackPanel Spacing="4">
                                <controls:TranslatedTextBlock Text="Polling rate"
                                                              TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.PollingRateText, Mode=OneWay}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="DpiTile" Grid.Column="3" Style="{StaticResource PulsarCardStyle}" Padding="16" Margin="8,0,0,0">
                            <StackPanel Spacing="4">
                                <controls:TranslatedTextBlock Text="DPI"
                                                              TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.DpiText, Mode=OneWay}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
