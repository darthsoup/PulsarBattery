<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PulsarBattery.Pages.MouseSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PulsarBattery.Controls"
    xmlns:local="using:PulsarBattery.Pages"
    xmlns:settingscontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="RootGrid"
              Padding="32,24,32,32"
              Background="Transparent"
              PointerPressed="RootGrid_PointerPressed">
            <StackPanel Spacing="24" MaxWidth="1000">

                <Grid x:Name="PageHeader" ColumnSpacing="16" RowSpacing="16"
                      SizeChanged="PageHeader_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Cancel the title line-height slack to match the other page sections. -->
                    <controls:TranslatedTextBlock x:Name="PageTitle"
                                                  Text="Mouse Settings"
                                                  Grid.ColumnSpan="2"
                                                  TextStyle="{ThemeResource TitleTextBlockStyle}"
                                                  TextWrapping="Wrap"
                                                  Margin="0,0,0,-8" />
                    <Button x:Name="RefreshSettingsButton"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Click="RefreshSettingsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <controls:TranslatedTextBlock Text="Refresh settings" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid x:Name="SettingsProgressPanel"
                      ColumnSpacing="12"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing x:Name="SettingsProgressRing"
                                  Width="20"
                                  Height="20"
                                  IsActive="False" />
                    <TextBlock x:Name="SettingsProgressText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                </Grid>

                <!-- Visibility must track IsOpen so a closed InfoBar consumes no section spacing. -->
                <InfoBar x:Name="ApplyInfoBar"
                         Severity="Warning"
                         IsOpen="{x:Bind ViewModel.MouseSettingsErrorOpen, Mode=OneWay}"
                         Visibility="{x:Bind local:MouseSettingsPage.BoolToVisibility(ViewModel.MouseSettingsErrorOpen), Mode=OneWay}"
                         Message="{x:Bind ViewModel.MouseSettingsErrorText, Mode=OneWay}"
                         CloseButtonClick="ApplyInfoBar_CloseButtonClick"
                         IsClosable="True" />

                <Border x:Name="UnsupportedSettingsPanel"
                        Style="{StaticResource PulsarCardStyle}"
                        Padding="32,48"
                        MinHeight="300"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="16">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="28"
                                Width="56"
                                Height="56"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE962;"
                                      FontSize="24"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <controls:TranslatedTextBlock Text="This device cannot be configured"
                                                      TextStyle="{ThemeResource SubtitleTextBlockStyle}"
                                                      TextWrapping="Wrap"
                                                      TextAlignment="Center"
                                                      HorizontalAlignment="Center" />
                        <controls:TranslatedTextBlock Text="Connect a supported mouse to change its settings"
                                                      TextStyle="{ThemeResource CaptionTextBlockStyle}"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      TextAlignment="Center"
                                                      TextWrapping="Wrap"
                                                      HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="24" Visibility="{x:Bind ViewModel.MouseSettingsVisibility, Mode=OneWay}">

                    <InfoBar Severity="Informational"
                             IsOpen="{x:Bind ViewModel.MouseSettingsReadOnly, Mode=OneWay}"
                             Visibility="{x:Bind local:MouseSettingsPage.BoolToVisibility(ViewModel.MouseSettingsReadOnly), Mode=OneWay}"
                             Message="{x:Bind ViewModel.MouseSettingsReadOnlyText, Mode=OneWay}"
                             IsClosable="False" />

                    <InfoBar Severity="Warning"
                             IsOpen="{x:Bind ViewModel.MouseSettingsWriteUnverified, Mode=OneWay}"
                             Visibility="{x:Bind local:MouseSettingsPage.BoolToVisibility(ViewModel.MouseSettingsWriteUnverified), Mode=OneWay}"
                             Title="{x:Bind ViewModel.MouseSettingsWriteUnverifiedTitle, Mode=OneWay}"
                             Message="{x:Bind ViewModel.MouseSettingsWriteUnverifiedText, Mode=OneWay}"
                             IsClosable="False" />

                    <StackPanel x:Name="PerformanceSection" Spacing="4">
                        <controls:TranslatedTextBlock Text="Performance"
                                                      TextStyle="{ThemeResource BodyStrongTextBlockStyle}"
                                                      Margin="0,0,0,4" />

                        <settingscontrols:SettingsCard x:Name="PollingRateCard">
                            <ComboBox x:Name="PollingRateComboBox"
                                      MinWidth="140"
                                      SelectionChanged="PollingRateComboBox_SelectionChanged" />
                        </settingscontrols:SettingsCard>

                        <settingscontrols:SettingsCard x:Name="DpiCard">
                            <NumberBox x:Name="DpiNumberBox"
                                       Minimum="50"
                                       Maximum="26000"
                                       SmallChange="50"
                                       LargeChange="400"
                                       SpinButtonPlacementMode="Compact"
                                       ValueChanged="DpiNumberBox_ValueChanged"
                                       Width="140" />
                        </settingscontrols:SettingsCard>

                        <settingscontrols:SettingsCard x:Name="DpiStageCard">
                            <ComboBox x:Name="DpiStageComboBox"
                                      MinWidth="140"
                                      SelectionChanged="DpiStageComboBox_SelectionChanged" />
                        </settingscontrols:SettingsCard>

                        <settingscontrols:SettingsCard x:Name="DebounceCard">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <NumberBox x:Name="DebounceNumberBox"
                                           Minimum="0"
                                           Maximum="30"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Compact"
                                           ValueChanged="DebounceNumberBox_ValueChanged"
                                           Width="120" />
                                <TextBlock Text="ms"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </settingscontrols:SettingsCard>
                    </StackPanel>

                    <StackPanel x:Name="SensorSection" Spacing="4">
                        <controls:TranslatedTextBlock Text="Sensor"
                                                      TextStyle="{ThemeResource BodyStrongTextBlockStyle}"
                                                      Margin="0,0,0,4" />

                        <settingscontrols:SettingsCard x:Name="LodCard">
                            <ComboBox x:Name="LodComboBox"
                                      MinWidth="140"
                                      SelectionChanged="LodComboBox_SelectionChanged" />
                        </settingscontrols:SettingsCard>

                        <settingscontrols:SettingsCard x:Name="MotionSyncCard">
                            <ToggleSwitch x:Name="MotionSyncToggle"
                                          Toggled="MotionSyncToggle_Toggled" />
                        </settingscontrols:SettingsCard>

                        <settingscontrols:SettingsCard x:Name="AngleSnapCard">
                            <ToggleSwitch x:Name="AngleSnapToggle"
                                          Toggled="AngleSnapToggle_Toggled" />
                        </settingscontrols:SettingsCard>

                        <settingscontrols:SettingsCard x:Name="RippleControlCard">
                            <ToggleSwitch x:Name="RippleControlToggle"
                                          Toggled="RippleControlToggle_Toggled" />
                        </settingscontrols:SettingsCard>
                    </StackPanel>

                    <StackPanel x:Name="PowerSection" Spacing="4">
                        <controls:TranslatedTextBlock Text="Power"
                                                      TextStyle="{ThemeResource BodyStrongTextBlockStyle}"
                                                      Margin="0,0,0,4" />

                        <settingscontrols:SettingsCard x:Name="SleepCard">
                            <ComboBox x:Name="SleepComboBox"
                                      MinWidth="140"
                                      SelectionChanged="SleepComboBox_SelectionChanged" />
                        </settingscontrols:SettingsCard>
                    </StackPanel>

                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
